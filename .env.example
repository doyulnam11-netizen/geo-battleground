# Server (Node 22+). Production server serves dist and /ws on the same port.
PORT=3001
STATIC_DIR=dist
# Optional comma-separated allowed browser origins. In production, set to your actual frontend URLs.
# ALLOWED_ORIGINS=https://your-domain.example,https://your-frontend.example
# Vite build-time setting for a separate server. Leave empty for same-origin /ws.
VITE_SERVER_URL=
